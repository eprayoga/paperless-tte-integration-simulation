# Copy to .env.local and fill in. Never commit real values.
#
# All variables are SERVER-ONLY (no NEXT_PUBLIC_ prefix): the browser never sees
# the secret key or customer key. The Paperless API is reached through the
# Next.js proxy at /api/paperless, which adds the headers server-side.

# OAuth host, used for {{host_auth}}/login/oauth/authorize
PAPERLESS_HOST_AUTH=
# API host, used for {{host}}/integrated/...
PAPERLESS_HOST=
# `origin` query param sent to the OAuth page
PAPERLESS_ORIGIN=
# Callback Paperless redirects to with ?ttetoken=... (must point to this app)
PAPERLESS_REDIRECT_PAGE=http://localhost:3000/api/auth/callback
# Optional logo URL shown on the Paperless login page
PAPERLESS_LOGO=

# Sent as the `customer-key` header and `customer_key` OAuth param
PAPERLESS_CUSTOMER_KEY=
# Sent as the `secret-key` header. Keep private.
PAPERLESS_SECRET_KEY=
